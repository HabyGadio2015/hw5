# Copy this file to .env in this folder (hw5/.env) and fill in your own key.
# .env is git-ignored. Never commit it.

# Required: your Portkey API key (used for every agent's model calls)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional override (remove the leading # to use)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# The model is intentionally NOT configurable here. Every agent in
# backend/agents.py is hardcoded to gpt-6-luna per the assignment rules.
